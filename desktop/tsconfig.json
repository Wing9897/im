{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": [
    "main.ts",
    "preload.ts",
    "window-controls.ts",
    "window-controls-channels.ts",
    "connection.ts",
    "connection-channels.ts",
    "connection-ipc.ts",
    "tray.ts",
    "menu.ts",
    "process-manager.ts",
    "process-manager-schema.ts",
    "process-manager-health.ts",
    "process-manager-spawn.ts",
    "process-manager-lifecycle.ts",
    "schema-baseline-dialog.ts",
    "schema-baseline-dialog-preload.ts",
    "schema-baseline-dialog-channels.ts",
    "local-db-reset.ts",
    "shell-i18n.ts",
    "paths.ts",
    "notifications.ts",
    "chromium-cache.ts"
  ],
  "exclude": ["node_modules", "dist", "release"]
}
