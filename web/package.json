{
  "name": "intelligence-monitor-web",
  "private": true,
  "version": "0.1.0-beta.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "gen:themes": "tsx ../scripts/generate-theme-css.mjs",
    "build": "npm run gen:themes && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.vitest.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "openapi:types": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "i18next": "26.3.6",
    "leaflet": "1.9.4",
    "lucide-react": "1.16.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.10",
    "react-leaflet": "4.2.1",
    "react-rnd": "10.5.2",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.33.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
